<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check if we have found failed renewals record type</description>
        <name>Check_if_record_type_found</name>
        <label>Check if record type found</label>
        <locationX>1007</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Record_Type_Yes_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Failed_Renewals_Record_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Renewed_or_Lapsed</targetReference>
            </connector>
            <label>Record Type - Yes found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if we found the related case that hasnt been yet updated to lapsed</description>
        <name>Lapsed_Check_if_case_was_found</name>
        <label>Lapsed - Check if case was found</label>
        <locationX>710</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lasped_Yes_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lapsed_Find_Related_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Case_as_Lapsed</targetReference>
            </connector>
            <label>Lapsed - Yes found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if we found the related case that hasnt been yet updated to renewed</description>
        <name>Renewed_Check_if_case_was_found</name>
        <label>Renewed - Check if case was found</label>
        <locationX>182</locationX>
        <locationY>755</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Renewed_Yes_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Renewed_Find_Related_Case</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Case_as_Renewed</targetReference>
            </connector>
            <label>Renewed - Yes found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if policy was updated to renewed or lapsed</description>
        <name>Renewed_or_Lapsed</name>
        <label>Renewed or Lapsed?</label>
        <locationX>644</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Policy_Renewed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Renewed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Renewed_Find_Related_Case</targetReference>
            </connector>
            <label>Policy Renewed</label>
        </rules>
        <rules>
            <name>Policy_Lapsed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lapsed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lapsed_Find_Related_Case</targetReference>
            </connector>
            <label>Policy Lapsed</label>
        </rules>
    </decisions>
    <description>When policy status is updated to renewed, check for opened failed renewal case and if one is found, close it.</description>
    <environments>Default</environments>
    <interviewLabel>Insurance Policy - Close Failed Renewal Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Insurance Policy - Close Failed Renewal Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Failed Renewal Record Type to assign to a new case</description>
        <name>Get_Failed_Renewals_Record_Type</name>
        <label>Get Failed Renewals Record Type</label>
        <locationX>1007</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_record_type_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Failed_Renewals</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Case</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Find the case that needs to be updated to lapsed</description>
        <name>Lapsed_Find_Related_Case</name>
        <label>Lapsed - Find Related Case</label>
        <locationX>710</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Lapsed_Check_if_case_was_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Failed_Renewals_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Insurance_Policy__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Policy_Renewal_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Renewal_Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Lapsed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Find the case that needs to be updated to renewed</description>
        <name>Renewed_Find_Related_Case</name>
        <label>Renewed - Find Related Case</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Renewed_Check_if_case_was_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Failed_Renewals_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Renewed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Insurance_Policy__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Policy_Renewal_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.Renewal_Date__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Close case with Lapsed status</description>
        <name>Close_Case_as_Lapsed</name>
        <label>Close Case as Lapsed</label>
        <locationX>578</locationX>
        <locationY>863</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Lapsed_Find_Related_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Lapsed_Reason__c</field>
            <value>
                <stringValue>Auto_Closed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Lapsed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <description>Close case with Renewed status</description>
        <name>Close_Case_as_Renewed</name>
        <label>Close Case as Renewed</label>
        <locationX>50</locationX>
        <locationY>863</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Renewed_Find_Related_Case.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Lapsed_Reason__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Renewed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <start>
        <locationX>881</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Failed_Renewals_Record_Type</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Renewed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Lapsed</stringValue>
            </value>
        </filters>
        <object>InsurancePolicy</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Find_Open_Cases</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <description>Failed Renewal case to close</description>
        <name>varCaseToClose</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
