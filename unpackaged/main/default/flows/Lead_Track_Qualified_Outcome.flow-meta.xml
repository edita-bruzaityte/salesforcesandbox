    <recordUpdates>
        <description>Update why Lead is being moved to qualified and populate total number of calls made</description>
        <name>Update_Lead</name>
        <label>Update Lead</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>Calls_made__c</field>
            <value>
                <elementReference>varTotalTasks</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead_Outcome_Retired__c</field>
            <value>
                <elementReference>Get_the_most_recent_Call_task.Call_Outcome__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_related_call_tasks</targetReference>
        </connector>
        <filterFormula>AND(
NOT({!$User.Username}=&quot;integration@admiral.com&quot;),
OR(
ISPICKVAL({!$Record.Status}, &quot;Qualified&quot;),
ISPICKVAL({!$Record.Status}, &quot;Converted&quot;),
ISPICKVAL({!$Record.Status}, &quot;Closed - Not Converted&quot;)
)
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
