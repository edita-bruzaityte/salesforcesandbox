<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Count_total_tasks</name>
        <label>Count total tasks</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>varTotalTasks</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_all_related_call_tasks</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_the_most_recent_Call_task</targetReference>
        </connector>
    </assignments>
    <description>This helps to track what happened with each lead that agents moved to Qualified status and why

14th March, 2024 - additional statuses -  trigger on anything Converted and Not Converted too.</description>
    <environments>Default</environments>
    <interviewLabel>Lead - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Track Qualified Outcome</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
