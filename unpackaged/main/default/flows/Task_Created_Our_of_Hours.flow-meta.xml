<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Create_Hour</name>
        <label>Assign Create Hour</label>
        <locationX>446</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>checkCreateHour</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varTaskCreateHour</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Task_Creater_Outside_Business_Hours</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_if_Weekend</name>
        <label>Check if Weekend</label>
        <locationX>248</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Assign_Create_Hour</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Saturday_Sunday</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varWeekendFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varWeekendFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Out_of_Hours</targetReference>
            </connector>
            <label>Saturday/Sunday</label>
        </rules>
    </decisions>
    <decisions>
        <description>Created before 9am &amp; after 6pm</description>
        <name>Task_Creater_Outside_Business_Hours</name>
        <label>Task Creater Outside Business Hours</label>
        <locationX>446</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Outside_of_Hours</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varTaskCreateHour</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>9.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varTaskCreateHour</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Task_Out_of_Hours</targetReference>
            </connector>
            <label>Yes, Outside of Hours</label>
        </rules>
    </decisions>
    <description>This flow will run every time new Task is created to check if its Out of Hours and mark it on the record so it can be used in the reporting</description>
    <environments>Default</environments>
    <formulas>
        <name>varTaskCreateHour</name>
        <dataType>Number</dataType>
        <expression>VALUE( MID( TEXT(  {!$Record.Create_Date_Time__c}-0 ), 12, 2 ) )</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varWeekendFormula</name>
        <dataType>Number</dataType>
        <expression>WEEKDAY(DATEVALUE({!$Record.Create_Date_Time__c}))</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Task - Created Our of Hours {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task - Created Our of Hours</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Check Outside of Hours checkbox on the Task record</description>
        <name>Mark_Task_Out_of_Hours</name>
        <label>Mark Task Out of Hours</label>
        <locationX>314</locationX>
        <locationY>611</locationY>
        <inputAssignments>
            <field>Out_of_Hours__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update Our of Hours field to mark Task was created outside of normal business hours</description>
        <name>Update_Out_of_Hours</name>
        <label>Update Out of Hours</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Out_of_Hours__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>122</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Weekend</targetReference>
        </connector>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>checkCreateHour</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
