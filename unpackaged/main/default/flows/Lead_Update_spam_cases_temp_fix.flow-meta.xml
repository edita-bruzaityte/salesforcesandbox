<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Run formula to check if lead is a spam</description>
        <name>Check_if_Spam</name>
        <label>Check if Spam</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_spam</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFormula</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_as_spam</targetReference>
            </connector>
            <label>Yes - spam</label>
        </rules>
        <rules>
            <name>Yes_spam2</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>+447123456789</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>07123456789</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>+44 7123 456789</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_as_spam</targetReference>
            </connector>
            <label>Yes - spam</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varFormula</name>
        <dataType>Boolean</dataType>
        <expression>IF(
        ISNUMBER(LEFT({!$Record.Email}, 5)),
    True,
    False
)</expression>
    </formulas>
    <formulas>
        <name>varRegexFormula</name>
        <dataType>Number</dataType>
        <expression>IF(
    AND(
        LEN({!$Record.Email}) = 5,
        ISNUMBER(LEFT({!$Record.Email}, 5))
    ),
    1,
    0
)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Lead - Update spam cases {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Update spam cases (temp fix)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_as_spam</name>
        <label>Update as spam</label>
        <locationX>176</locationX>
        <locationY>623</locationY>
        <inputAssignments>
            <field>Spam__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_Spam</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
