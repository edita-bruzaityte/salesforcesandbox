    <description>Track how long Task was in the Queue before it was assigned to an agent</description>
    <environments>Default</environments>
    <formulas>
        <name>varCalculatedHours</name>
        <dataType>Number</dataType>
        <expression>{!varTotalMinutes}/60</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>varHoursInQueue</name>
        <dataType>Number</dataType>
        <expression>ROUND( 9 * (

( 5 * FLOOR( ( DATEVALUE( {!$Flow.CurrentDateTime} ) - DATE( 1900, 1, 8) ) / 7) +

MIN(5,

MOD( DATEVALUE( {!$Flow.CurrentDateTime}) - DATE( 1900, 1, 8), 7) +

MIN( 1, 24 / 9 * ( MOD( {!$Flow.CurrentDateTime} - DATETIMEVALUE( &#39;1900-01-08 09:00:00&#39; ), 1 ) ) )

)

)

-

( 5 * FLOOR( ( DATEVALUE( {!$Record.Create_Date_Time__c} ) - DATE( 1900, 1, 8) ) / 7) +

MIN( 5,

MOD( DATEVALUE( {!$Record.Create_Date_Time__c} ) - DATE( 1996, 1, 1), 7 ) +

MIN( 1, 24 / 9 * ( MOD( {!$Record.Create_Date_Time__c} - DATETIMEVALUE( &#39;1900-01-08 09:00:00&#39; ), 1) ) )

)

)

),

0 )</expression>
        <scale>0</scale>
    </formulas>
