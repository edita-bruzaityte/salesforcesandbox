<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_Integration_User</name>
        <label>If Integration User</label>
        <locationX>495</locationX>
        <locationY>372</locationY>
        <defaultConnector>
            <targetReference>Create_Task_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_is_integration_user</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner.Username</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>integration@admiral.com</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>General Integration Profile</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sales_Queue</targetReference>
            </connector>
            <label>Yes, is integration user</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Referral_Reason_Updated</name>
        <label>Is Referral Reason Updated?</label>
        <locationX>168</locationX>
        <locationY>372</locationY>
        <defaultConnectorLabel>Not Updated</defaultConnectorLabel>
        <rules>
            <name>Yes_Referral_Reason_Updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Referral_Reason__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Referral_Reason__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Sale Complete</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Integration_User</targetReference>
            </connector>
            <label>Yes, Referral Reason Updated</label>
        </rules>
    </decisions>
