    <description>Removes non-numeric chars from a alphanumeric string</description>
    <environments>Default</environments>
    <formulas>
        <name>ActualInputLength</name>
        <dataType>Number</dataType>
        <expression>LEN({!InputAlphaNumericString})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FirstChar</name>
        <dataType>String</dataType>
        <expression>left({!InputAlphaNumericString}, 1)</expression>
    </formulas>
    <formulas>
        <name>InputWithoutSpaces</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(TRIM({!InputAlphaNumericString}) , &#39; &#39; , &#39;&#39;)</expression>
    </formulas>
    <formulas>
        <name>IsNumber</name>
        <dataType>Boolean</dataType>
        <expression>ISNUMBER({!FirstChar})</expression>
    </formulas>
    <formulas>
        <name>Trim1stchar</name>
        <dataType>String</dataType>
        <expression>TRIM(RIGHT({!InputAlphaNumericString},{!InputLength}-1))</expression>
    </formulas>
    <interviewLabel>Strip Alpha Chars from AlphaNumeric String {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Strip Alpha Chars from AlphaNumeric String</label>
