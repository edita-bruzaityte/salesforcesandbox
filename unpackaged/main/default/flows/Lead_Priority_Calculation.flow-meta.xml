    <environments>Default</environments>
    <formulas>
        <description>10.0 - The added minutes to the current datetime.
1440 - The total number of minutes of the 24 hours.</description>
        <name>currentDateTimePlus10Minutes</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (10.0 / 1440)</expression>
    </formulas>
    <formulas>
        <name>isNewLead</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>isPhoneValid</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(
    {!sanitisedPhoneFormula},
    &quot;^(\\+44\\s?\\d{10}|44\\d{10}|0\\d{10})$&quot;
  )</expression>
    </formulas>
    <formulas>
        <name>sanitisedPhoneFormula</name>
        <dataType>String</dataType>
        <expression>IF(
BEGINS(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), &#39;+44&#39;),
SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;),
IF(
BEGINS(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), &#39;0&#39;),
&#39;+44&#39; &amp; right(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), (LEN(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;)) - 1)),
SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;)
)
)</expression>
    </formulas>
