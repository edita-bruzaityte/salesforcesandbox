<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assign number of tasks captured under Get all tasks action</description>
        <name>Count_how_many_tasks</name>
        <label>Count how many tasks</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>varTotalTasks</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_all_Log_a_Call_tasks</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_most_recent_task</targetReference>
        </connector>
    </assignments>
    <description>Retired on 1st September, 2025 as new process with dialler has been implemented. It has v2 of Lead Outcome (picklist) which is automatically updated when Call Outcome is updated on the related Voice Call. So since calls are logged automatically, agents dont need to manually create Log a Call tasks anymore too, meaning this automation is irrelevant.

Triggers only under very specific conditions and create only to update Lead Outcome field on the related Lead.</description>
    <environments>Default</environments>
    <interviewLabel>Task (Log a Call) - Update Lead Outcome {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Task (Log a Call) - Update Lead Outcome</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all Log a Call tasks for the related lead</description>
        <name>Get_all_Log_a_Call_tasks</name>
        <label>Get all Log a Call tasks</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Count_how_many_tasks</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7)</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 1</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 2</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 3</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 4</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 5</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 6</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_most_recent_task</name>
        <label>Get most recent task</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Lead_Outcome_on_the_Lead</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7)</filterLogic>
        <filters>
            <field>WhoId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 1</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 2</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 3</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 4</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 5</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject2__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Call 6</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update Lead Outcome field using the Call Outcome information from the most recent task</description>
        <name>Update_Lead_Outcome_on_the_Lead</name>
        <label>Update Lead Outcome on the Lead</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhoId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Calls_made__c</field>
            <value>
                <elementReference>varTotalTasks</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead_Outcome_Retired__c</field>
            <value>
                <elementReference>Get_most_recent_task.Call_Outcome__c</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_all_Log_a_Call_tasks</targetReference>
        </connector>
        <filterFormula>AND(
   NOT(ISNULL({!$Record.Name__c})),
OR(
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 1&quot;),
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 2&quot;),
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 3&quot;),
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 4&quot;),
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 5&quot;),
   ISPICKVAL({!$Record.Subject2__c}, &quot;Call 6&quot;)

)
)</filterFormula>
        <object>Task</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
