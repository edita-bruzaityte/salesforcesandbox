    <decisions>
        <name>Priority_Check</name>
        <label>Priority Check</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Priority_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Trade__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tree Surgeon</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Lead_Priority_1</targetReference>
            </connector>
            <label>Priority 1</label>
        </rules>
        <rules>
            <name>Priority_2</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AB Liability</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tools</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quoted_Price__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>300.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Lead_Priority_2</targetReference>
            </connector>
            <label>Priority 2</label>
        </rules>
        <rules>
            <name>Priority_3</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AB Liability</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tools</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quoted_Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>200.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quoted_Price__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>300.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Lead_Priority_3</targetReference>
            </connector>
            <label>Priority 3</label>
        </rules>
        <rules>
            <name>Priority_4</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AB Liability</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Policy_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Tools</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quoted_Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>200.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quoted_Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Lead_Priority_4</targetReference>
            </connector>
            <label>Priority 4</label>
        </rules>
    </decisions>
    <description>This flow is shorter version of what once was Priority Calculation for dialer through amazon campaigns (so if looking to reactivate that, look for Lead - Priority Calculation flow). This flow will simply calculate and assign priority to the incoming leads so they can be appropriately distributed. by the Omni Channel.</description>
    <environments>Default</environments>
    <formulas>
        <description>10.0 - The added minutes to the current datetime.
1440 - The total number of minutes of the 24 hours.</description>
        <name>currentDateTimePlus10Minutes</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (10.0 / 1440)</expression>
    </formulas>
    <formulas>
        <name>isNewLead</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>isPhoneValid</name>
        <dataType>Boolean</dataType>
        <expression>REGEX(
    {!sanitisedPhoneFormula},
    &quot;^(\\+44\\s?\\d{10}|44\\d{10}|0\\d{10})$&quot;
  )</expression>
    </formulas>
    <formulas>
        <name>sanitisedPhoneFormula</name>
        <dataType>String</dataType>
        <expression>IF(
BEGINS(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), &#39;+44&#39;),
SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;),
IF(
BEGINS(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), &#39;0&#39;),
&#39;+44&#39; &amp; right(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;), (LEN(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;)) - 1)),
SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &#39;-&#39;, &#39;&#39;), &#39;)&#39;, &#39;&#39;), &#39;(&#39;, &#39;&#39;), &#39; &#39;, &#39;&#39;)
)
)</expression>
    </formulas>
