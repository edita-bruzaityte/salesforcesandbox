<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assign number of calls found</description>
        <name>Assign_Calls</name>
        <label>Assign Calls</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalVoiceCallRecordCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Dialler_Outbound_Calls</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Total_Number_of_Calls</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Stores 4 call value</description>
        <name>var4Calls</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>4.0</numberValue>
        </value>
    </constants>
    <decisions>
        <description>If total calls made is 4 or more close the lead</description>
        <name>Check_Total_Number_of_Calls</name>
        <label>Check Total Number of Calls</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X4_or_more</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalVoiceCallRecordCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>var4Calls</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Move_Lead_to_Closed_Not_Converted</targetReference>
            </connector>
            <label>4 or more</label>
        </rules>
    </decisions>
    <description>This flow will check total number of calls and latest lead outcome to determine if lead needs to be closed as not converted</description>
    <environments>Default</environments>
    <interviewLabel>Voice Call - Update Lead Status (Voicemail &amp; No Contact Made) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Voice Call - Update Lead Status (Voicemail &amp; No Contact Made)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create error log record if component fails</description>
        <name>Create_Error_Log</name>
        <label>Create Error Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Automation_Name__c</field>
            <value>
                <stringValue>Lead - Update Lead Status</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Fault_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Record__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Running_User__c</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Error_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get all the records that have been made by dialler or manually (call type = outbound)</description>
        <name>Get_Dialler_Outbound_Calls</name>
        <label>Get Dialler &amp; Outbound Calls</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Calls</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>RelatedRecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RelatedRecordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>CallType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Outbound</stringValue>
            </value>
        </filters>
        <filters>
            <field>OP_Dialler__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>VoiceCall</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update lead status to closed - not converted</description>
        <name>Move_Lead_to_Closed_Not_Converted</name>
        <label>Move Lead to Closed - Not Converted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Create_Error_Log</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RelatedRecordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed - Not Converted</stringValue>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Dialler_Outbound_Calls</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>OP_OutboundCallOutcome__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Voicemail left</stringValue>
            </value>
        </filters>
        <filters>
            <field>OP_OutboundCallOutcome__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No contact made</stringValue>
            </value>
        </filters>
        <object>VoiceCall</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <description>Total record count</description>
        <name>varTotalVoiceCallRecordCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
