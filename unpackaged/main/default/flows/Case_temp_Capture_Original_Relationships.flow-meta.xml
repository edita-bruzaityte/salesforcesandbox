<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>This flow will be used to store linked Account, Contact name, Contact Email address, Entitlement and Email address from the Account in separate text fields before Account, Contact and Entitlement records are removed from SF to be replaced with cleansed data.
It also will store an email address stored against Account as an alternative one to use if Web Email doesnt link all records.</description>
    <environments>Default</environments>
    <interviewLabel>Case (temp) - Capture Original Relationships {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case (temp) - Capture Original Relationships</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Capture the detail from relationship fields</description>
        <name>Capture_lookup_fields</name>
        <label>Capture lookup fields</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>Account_Name_temp__c</field>
            <value>
                <elementReference>$Record.Account.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Additional_Email__c</field>
            <value>
                <elementReference>$Record.Account.Email_Address__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Additional_Email_temp__c</field>
            <value>
                <elementReference>$Record.Account.Email_Address__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactFirstNametemp__c</field>
            <value>
                <elementReference>$Record.Contact.FirstName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact_Last_Name_temp__c</field>
            <value>
                <elementReference>$Record.Contact.LastName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email_temp__c</field>
            <value>
                <elementReference>$Record.ContactEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Entitlement_Id_temp__c</field>
            <value>
                <elementReference>$Record.Entitlement.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Entitlement_name_temp__c</field>
            <value>
                <elementReference>$Record.Entitlement.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Insurance_Policy_temp__c</field>
            <value>
                <elementReference>$Record.Insurance_Policy__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Capture_lookup_fields</targetReference>
        </connector>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
