            <conditions>
                <leftValueReference>$Record.Subject</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varSeventhTask</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Close_Renewal_Opp</targetReference>
            </connector>
            <label>7th Task</label>
        </rules>
    </decisions>
    <description>This flow will trigger when very first renewal task from the Acton Plan is complete to make updates to the following fields on the Action Plan: Actual Start Date, Actual End Date, Status, Assigned To field on Task and Action Plan Items field on Opportunity</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate actual end date to update  End Date field on Action plan</description>
        <name>varActualEndDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()+ 7</expression>
    </formulas>
    <formulas>
        <description>Every time Failed Instalment task is completed Action Plan Item field should be recalculated to add 1 more to the existing total</description>
        <name>varCalculateTotalItemsCompleted</name>
        <dataType>Number</dataType>
        <expression>{!Get_Renewal_Opportunity.Action_Plan_Items__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Task (Failed &amp; Non Auto Renewals) - Update Action Plan &amp; Tasks {!$Flow.CurrentDateTime}</interviewLabel>
