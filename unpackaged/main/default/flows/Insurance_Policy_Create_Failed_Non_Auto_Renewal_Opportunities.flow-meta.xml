    <decisions>
        <description>Check if flow found Failed Renewals Action plan template</description>
        <name>Check_Failed_Renewals_Action_Plan_Template</name>
        <label>Check Failed Renewals Action Plan Template</label>
        <locationX>842</locationX>
        <locationY>792</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Failed_Renewals_template_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Failed_Renewals_Action_Plan_Template</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Non_Auto_Renewals_Action_Plan_Template</targetReference>
            </connector>
            <label>Failed Renewals template found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if current date falls between Mon-Fri. This will adjust scheduled flow&#39;s execution to Mon-Fri only.</description>
        <name>Check_if_Mon_Fri</name>
        <label>Check if Mon-Fri</label>
        <locationX>1370</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_its_Mon_Fri</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMonFri</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Renewal_Opportunity</targetReference>
            </connector>
            <label>Yes its Mon-Fri</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if we found Renewal opportunity related to the policy</description>
        <name>Check_if_Opportunity_Found</name>
        <label>Check if Opportunity Found</label>
