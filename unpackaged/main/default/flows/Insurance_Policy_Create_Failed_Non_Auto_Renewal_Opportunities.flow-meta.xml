            </connector>
            <label>Found Renewal Opp</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check insurance policy conditions which will determine if we create failed renewal or non auto renewal case</description>
        <name>Check_Insurance_Policy_Conditions</name>
        <label>Check Insurance Policy Conditions</label>
        <locationX>314</locationX>
        <locationY>1008</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Create_Failed_Renewal_case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Failed_to_Renew__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Renewal_Opp</targetReference>
            </connector>
            <label>Create Failed Renewal Case</label>
        </rules>
        <rules>
            <name>Create_Non_Auto_Renewal_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Due_For_Renewal_14_Days__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Renewal_Opp2</targetReference>
            </connector>
            <label>Create Non Auto Renewal Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check if flow found Non Auto Renewals Action plan template</description>
        <name>Check_Non_Auto_Renewals_Action_Plan_Template</name>
        <label>Check Non Auto Renewals Action Plan Template</label>
        <locationX>578</locationX>
        <locationY>900</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Non_Auto_Renewals_template_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Non_Auto_Renewals_Action_Plan_Template</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Insurance_Policy_Conditions</targetReference>
            </connector>
            <label>Non Auto Renewals template found</label>
        </rules>
    </decisions>
    <description>This flow will run daily to check which policies failed to renew and are due to renew in 14 days but have non auto renew checked and will create an opportunity for customer service to follow up</description>
    <environments>Default</environments>
    <formulas>
        <name>varFailedRenewalEndDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 6</expression>
    </formulas>
    <formulas>
        <description>Formula to check for Mon-Fri in the flow</description>
        <name>varMonFri</name>
        <dataType>Boolean</dataType>
        <expression>WEEKDAY({!$Flow.CurrentDate}) &gt;= 2 

&amp;&amp; WEEKDAY({!$Flow.CurrentDate}) &lt;= 6</expression>
    </formulas>
    <formulas>
        <name>varNonAutoRenewalEndDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 14</expression>
    </formulas>
    <interviewLabel>Insurance Policy - Create Failed &amp; Non Auto Renewal Opportunities {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Insurance Policy - Create Failed &amp; Non Auto Renewal Opportunities</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
