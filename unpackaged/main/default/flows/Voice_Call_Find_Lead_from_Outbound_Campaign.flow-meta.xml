<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Lead_for_Update</name>
        <label>Set Lead for Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>leadToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.OP_OutboundCallDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Check_Business_Hours.output_DateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.Lead_Outcome2__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No contact made</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Voice_Call</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Lead_for_Update_Clear</name>
        <label>Set Lead for Update (Clear)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>leadToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.OP_OutboundCallAttempt__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.OP_OutboundCallDate__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed - Not Converted</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>leadToUpdate.Lead_Outcome2__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No contact made</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Voice_Call</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Next_Call_Attempt</name>
        <label>Set Next Call Attempt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>leadToUpdate.OP_OutboundCallAttempt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NextCallAttemptFormula</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Business_Hours</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Voice_Call_Updates</name>
        <label>Set Voice Call Updates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.OP_OutboundCallOutcome__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No contact made</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_New_Business_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.OP_Dialler__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.RelatedRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>voiceCallToUpdate.OP_CallAttempt__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Lead.OP_OutboundCallAttempt__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Previous_Call_Attempt</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Lead_Outbound_Call_Attempt</name>
        <label>Check Lead Outbound Call Attempt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outbound_Attempted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.OP_OutboundCallDate__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.OP_OutboundCallAttempt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_New_Business_Queue</targetReference>
            </connector>
            <label>Outbound Attempted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Previous_Call_Attempt</name>
        <label>Check Previous Call Attempt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Lead_for_Update_Clear</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Call_Attempted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.OP_OutboundCallAttempt__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Phone_Ring_Status</targetReference>
            </connector>
            <label>Call Attempted</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Another_Attempt</name>
        <label>Has Another Attempt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Set_Lead_for_Update_Clear</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Another_Attempt2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NextCallAttemptFormula</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Next_Call_Attempt</targetReference>
            </connector>
            <label>Has Another Attempt</label>
        </rules>
    </decisions>
    <decisions>
        <name>Phone_Ring_Status</name>
        <label>Phone Ring Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Business_Hours</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Phone_Rings</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_UNANSWERED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_BUSY</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_TIMEOUT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CUSTOMER_NEVER_ARRIVED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>THIRD_PARTY_DISCONNECT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CUSTOMER_DISCONNECT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AGENT_DISCONNECT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BARGED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_POTENTIAL_BLOCKING</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Another_Attempt</targetReference>
            </connector>
            <label>Phone Rings</label>
        </rules>
        <rules>
            <name>No_Phone_Ring</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_PROBLEM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EXPIRED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Voice_Call_record</targetReference>
            </connector>
            <label>No Phone Ring</label>
        </rules>
        <rules>
            <name>Phone_Ring_Undetermined</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_ORIGINATOR_CANCEL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CONTACT_FLOW_DISCONNECT</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OTHER</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Has_Another_Attempt</targetReference>
            </connector>
            <label>Phone Ring Undetermined</label>
        </rules>
        <rules>
            <name>Permanently_No_Phone_Ring</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>TELECOM_NUMBER_INVALID</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OUTBOUND_DESTINATION_ENDPOINT_ERROR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OUTBOUND_RESOURCE_ERROR</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DisconnectReason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OUTBOUND_ATTEMPT_FAILED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Has_Another_Attempt</targetReference>
            </connector>
            <label>Permanently No Phone Ring</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>60.0 or 120.0 - The added minutes to the current datetime.
1440 - The total number of minutes of the 24 hours.</description>
        <name>currentDateTimePlusMinutes</name>
        <dataType>DateTime</dataType>
        <expression>CASE({!NextCallAttemptFormula}, 
&quot;2nd Attempt&quot;, NOW() + (60.0 / 1440), 
&quot;3rd Attempt&quot;, NOW() + (60.0 / 1440), 
&quot;4th Attempt&quot;, NOW() + (120.0 / 1440), 
NOW() + (120.0 / 1440))</expression>
    </formulas>
    <formulas>
        <name>NextCallAttemptFormula</name>
        <dataType>String</dataType>
        <expression>CASE({!Get_Lead.OP_OutboundCallAttempt__c}, 
&quot;1st Attempt&quot;,  &quot;2nd Attempt&quot;, 
&quot;2nd Attempt&quot;, &quot;3rd Attempt&quot;, 
&quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Voice Call - Outbound Call Lead Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Voice Call - Find Lead from Outbound Campaign</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Voice_Call_record</name>
        <label>Delete Voice Call record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>voiceCallToUpdate</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Lead_Outbound_Call_Attempt</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND (3 OR 4)</filterLogic>
        <filters>
            <field>OP_Phone_Sanitised__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FromPhoneNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>Phone</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.FromPhoneNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Nurturing</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Business_Queue</name>
        <label>Get New Business Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Voice_Call_Updates</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Op_OmniNewBusiness</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Lead</name>
        <label>Update Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>leadToUpdate</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Voice_Call</name>
        <label>Update Voice Call</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Lead</targetReference>
        </connector>
        <inputReference>voiceCallToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FromPhoneNumber</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>CallDisposition</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>completed</stringValue>
            </value>
        </filters>
        <object>VoiceCall</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Check_Business_Hours</name>
        <label>Check Business Hours</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Lead_for_Update</targetReference>
        </connector>
        <flowName>Lead_Check_Business_Hours</flowName>
        <inputAssignments>
            <name>input_DateTime</name>
            <value>
                <elementReference>currentDateTimePlusMinutes</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>leadToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>voiceCallToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>VoiceCall</objectType>
    </variables>
</Flow>
