                    <stringValue>Unacceptable risk</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accept online</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Doesn&#39;t want quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Duplicate quote</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Invalid number</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not ready to purchase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>On Cover</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quoted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Taken elsewhere</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OP_OutboundCallOutcome__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Number blocked</stringValue>
                </rightValue>
