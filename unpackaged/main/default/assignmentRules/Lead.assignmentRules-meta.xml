<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Lead Assignment Rule</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Potential_High_Value_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Unqualified</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.NumberOfEmployees</field>
                <operation>greaterOrEqual</operation>
                <value>11</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Unqualified_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Unqualified</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Unqualified_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Qualified</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Policy_Type__c</field>
                <operation>equals</operation>
                <value>Tools</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Semi_Qualified_Leads</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Qualified</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
