<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BrokerCasMustHaveAssignedAgentBe4Closing</fullName>
    <active>true</active>
    <description>This validation rules will ensure that every Broker Question record type case is assigned to an agent before it can be closed.</description>
    <errorConditionFormula>AND(

      RecordType.DeveloperName = &#39;Broker_Questions&#39;,
      ISPICKVAL(Status, &#39;Closed&#39;),
      IF(BEGINS (OwnerId ,&quot;00G&quot;),true,false),
       $User.Id &lt;&gt; &#39;0054K00000460C3&#39;



)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>Case must be assigned to an agent to be closed</errorMessage>
</ValidationRule>
