<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Call_Outcome_is_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),

   NOT(ISPICKVAL($User.UserType, &quot;AutomatedProcess&quot;)),

   $User.LastName &lt;&gt; &quot;Connect-CRM2&quot;,
   OP_OutboundCampaignStatus__c = &quot;Answered&quot;,
   ISPICKVAL(OP_OutboundCallOutcome__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>OP_OutboundCallOutcome__c</errorDisplayField>
    <errorMessage>Call Outcome is required.</errorMessage>
</ValidationRule>
