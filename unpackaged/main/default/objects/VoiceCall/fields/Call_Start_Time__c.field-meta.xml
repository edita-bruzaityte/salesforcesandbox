<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Call_Start_Time__c</fullName>
    <description>Extracts time value from the Create Date field, as time doesnt show in the reports, date only.</description>
    <formula>TIMEVALUE( CallStartDateTime )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Call Start (Time)</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Time</type>
</CustomField>
