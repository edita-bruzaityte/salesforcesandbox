<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Update_Renewal_Opportunities</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Provide agents with access to update renewal insurance policy record type opportunities</description>
        <label>Update Renewal Opportunities</label>
        <sharedTo>
            <group>All_Agents_Supervisors</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Renewal Insurance Policy</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
