						<table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-spacing:0;">
							
								<tr>
									<td style="width:158px;"><img alt="" height="auto" src="https://cdn.sanity.io/images/vsoowbln/production/2edd5626650cecbbf9e902f205fbf73c832fc240-316x250.png" style="border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;" width="158" /></td>
								</tr>
							
