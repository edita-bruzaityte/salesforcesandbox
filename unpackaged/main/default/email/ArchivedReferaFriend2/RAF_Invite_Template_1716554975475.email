						<table border="0" cellpadding="0" cellspacing="0" style="" width="100%">
							
								<tr>
									<td align="left" class="x" style="font-size:0;padding-bottom:8px;word-break:break-word;">
									<div style="text-align:left;">
									<p style="Margin:0;text-align:left;mso-line-height-alt:24px;mso-ansi-font-size:16px;"><span style="font-size:16px;font-family:'Poppins','Helvetica',sans-serif;font-weight:400;color:#151a4f;line-height:150%;mso-line-height-alt:24px;mso-ansi-font-size:16px;">Hi {{{Recipient.FirstName}}},</span></p>

									<p style="Margin:0;mso-line-height-alt:24px;mso-ansi-font-size:16px;"><span style="font-size:16px;font-family:'Poppins','Helvetica',sans-serif;font-weight:400;color:#151a4f;line-height:150%;mso-line-height-alt:24px;mso-ansi-font-size:16px;">&nbsp;</span></p>

									<p style="Margin:0;mso-line-height-alt:24px;mso-ansi-font-size:16px;"><span style="font-size:16px;font-family:'Poppins','Helvetica',sans-serif;font-weight:400;color:#151a4f;line-height:150%;mso-line-height-alt:24px;mso-ansi-font-size:16px;">If your friends or work mates buy insurance with Admiral Business, we’ll send you and your friend a £30 Amazon voucher to say thanks.<br class="s" />
									<br class="s" />
									Win win!</span></p>

									<p style="Margin:0;mso-line-height-alt:24px;mso-ansi-font-size:16px;"><span style="font-size:16px;font-family:'Poppins','Helvetica',sans-serif;font-weight:400;color:#151a4f;line-height:150%;mso-line-height-alt:24px;mso-ansi-font-size:16px;">&nbsp;</span></p>
									</div>
									</td>
								</tr>
